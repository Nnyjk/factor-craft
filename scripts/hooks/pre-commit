#!/bin/bash
#
# Pre-commit hook: 编译检查
# 在每次 commit 前运行，确保代码能编译通过
#

echo "🔧 Pre-commit: 编译检查..."

cd "$(git rev-parse --show-toplevel)"

# 运行编译
if ./gradlew compileJava compileTestJava --quiet 2>&1 | grep -q "FAILED\|error:"; then
    echo ""
    echo "❌ 编译失败！请修复错误后再提交。"
    echo ""
    exit 1
fi

echo "✅ 编译通过"
exit 0